---
import "~/styles/global.css";
import GithubIcon from "~/assets/icons/github.svg";
import SeoHead from "~/components/seo/SeoHead.astro";
import StructuredData from "~/components/seo/StructuredData.astro";
import type { SeoProps } from "~/components/seo/types";
import { SITE_TITLE } from "~/consts";
import { Font } from "astro:assets";

interface Props extends SeoProps {
  chrome?: boolean;
  preloadMonoFont?: boolean;
}

const {
  preloadMonoFont = false,
  chrome = false,
  ...seo
} = Astro.props satisfies Props;

const isActive = Astro.url.pathname === "/";
---

<html lang="ko">
  <head>
    <SeoHead {...seo} />
    <StructuredData {...seo} />

    <Font cssVariable="--font-suit" preload />
    <Font cssVariable="--font-zen-serif-family" preload />
    {preloadMonoFont && <Font cssVariable="--font-geist-mono" preload />}
  </head>

  <body
    class="flex min-h-screen max-w-2xl flex-col gap-12 bg-white p-8 md:mx-auto md:px-2"
  >
    {
      !chrome && (
        <header class="flex items-center">
          <h1 class="font-zen-serif text-mds-muted grow text-base tracking-wider">
            {!isActive ? (
              <a
                href="/"
                class="text-mds-secondary cursor-pointer transition-opacity hover:opacity-70"
              >
                {SITE_TITLE}
              </a>
            ) : (
              <span>{SITE_TITLE}</span>
            )}
          </h1>
        </header>
      )
    }

    <main
      class:list={[
        "content-shell mt-6 flex-1 md:mt-10",
        !chrome ? "space-y-2" : "flex flex-col",
      ]}
    >
      <slot />
    </main>

    {
      !chrome && (
        <footer class="text-muted flex items-center justify-between text-center text-sm tracking-wide">
          <div class="text-left">© 2026 Minyeong Jeong</div>
          <nav>
            <a
              href="https://github.com/myjeong19"
              rel="noopener noreferrer"
              target="_blank"
              class="hover:text-tertiary flex items-center gap-2 transition-colors"
            >
              <GithubIcon class="size-4" />
              <span>Github</span>
            </a>
          </nav>
        </footer>
      )
    }
  </body>
</html>
