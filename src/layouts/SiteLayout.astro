---
import "~/styles/global.css";
import GithubIcon from "~/assets/icons/github.svg";
import SeoHead from "~/components/seo/SeoHead.astro";
import StructuredData from "~/components/seo/StructuredData.astro";
import type { SeoProps } from "~/components/seo/types";
import { SITE_TITLE } from "~/consts";
import { Font } from "astro:assets";

interface Props extends SeoProps {
  chrome?: boolean;
  preloadMonoFont?: boolean;
}

const {
  preloadMonoFont = false,
  chrome = false,
  ...seo
} = Astro.props satisfies Props;

const isActive = Astro.url.pathname === "/";
---

<html lang="ko">
  <head>
    <SeoHead {...seo} />
    <StructuredData {...seo} />

    <Font cssVariable="--font-suit" preload />
    <Font cssVariable="--font-zen-serif-family" preload />
    {preloadMonoFont && <Font cssVariable="--font-geist-mono" preload />}
  </head>

  <body
    class="flex min-h-screen max-w-2xl flex-col gap-12 bg-white p-8 antialiased md:mx-auto md:px-2"
  >
    {
      !chrome && (
        <header class="flex items-center">
          <h1 class="font-zen-serif grow text-base tracking-wider text-zinc-500">
            {!isActive ? (
              <a
                href="/"
                class="cursor-pointer text-zinc-900 transition-opacity hover:opacity-70"
              >
                {SITE_TITLE}
              </a>
            ) : (
              <span>{SITE_TITLE}</span>
            )}
          </h1>
        </header>
      )
    }

    <main
      class:list={[
        "content-shell mt-6 flex-1 md:mt-10",
        !chrome ? "space-y-2" : "flex flex-col",
      ]}
    >
      <slot />
    </main>

    {
      !chrome && (
        <footer class="flex items-center justify-between text-center text-xs tracking-wide text-zinc-500">
          <div class="text-left">© 2026 Minyeong Jeong</div>
          <nav>
            <a
              href="https://github.com/myjeong19"
              rel="noopener noreferrer"
              target="_blank"
              class="flex items-center gap-1 transition-colors duration-150 hover:text-zinc-800 hover:opacity-100"
            >
              <GithubIcon class="size-3.5" />
              <span class="text-sm">Github</span>
            </a>
          </nav>
        </footer>
      )
    }
  </body>
</html>
