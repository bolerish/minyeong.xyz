---
import Anchor from "~/components/Anchor.astro";
import { getPostDescription, getPosts } from "~/content/lib/posts";
import SiteLayout from "~/layouts/SiteLayout.astro";
import type { CollectionEntry } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "./consts";

const posts = (await getPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

type PostEntry = CollectionEntry<"posts">;

const postsByYear = posts.reduce<Record<string, PostEntry[]>>((acc, post) => {
  const year = String(post.data.pubDate.getFullYear());

  if (!acc[year]) {
    acc[year] = [];
  }

  acc[year].push(post);
  return acc;
}, {});

const groupedPosts = Object.entries(postsByYear).sort(
  ([a], [b]) => Number(b) - Number(a),
);
---

<SiteLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  contentType="website"
>
  {
    groupedPosts.map(([year, yearPosts]) => (
      <section class="flex items-start gap-4 pt-14 pb-24">
        <h2 class="py-1 text-xs leading-5 text-zinc-600">{year}</h2>

        <ul class="min-w-0 flex-1 space-y-2">
          {yearPosts.map((post) => (
            <li class="py-1 hover:bg-zinc-50">
              <Anchor
                href={`/${post.id}`}
                class="flex min-w-0 flex-col gap-1.5 rounded-md px-2 transition-colors duration-200"
              >
                <h3 class="truncate text-lg leading-5 font-normal text-zinc-900">
                  {post.data.title}
                </h3>
                <p class="mt-0.5 line-clamp-2 text-sm text-zinc-500">
                  {getPostDescription(post)}
                </p>
              </Anchor>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</SiteLayout>
