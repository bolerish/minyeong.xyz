---
import { SITE_DESCRIPTION, SITE_TITLE } from "~/consts";
import { getPostDescription, getPosts } from "~/content/lib/posts";
import SiteLayout from "~/layouts/SiteLayout.astro";
import type { CollectionEntry } from "astro:content";

const posts = (await getPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

type PostEntry = CollectionEntry<"posts">;

const postsByYear = posts.reduce<Record<string, PostEntry[]>>((acc, post) => {
  const year = String(post.data.pubDate.getFullYear());

  if (!acc[year]) {
    acc[year] = [];
  }

  acc[year].push(post);
  return acc;
}, {});

const groupedPosts = Object.entries(postsByYear).sort(
  ([a], [b]) => Number(b) - Number(a),
);
---

<SiteLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  contentType="website"
>
  {
    groupedPosts.map(([year, yearPosts]) => (
      <section class="flex items-start gap-4">
        <h2 class="text-secondary py-2 text-xs leading-5">{year}</h2>

        <ul class="min-w-0 flex-1 space-y-2">
          {yearPosts.map((post) => (
            <li class="px-1 py-2 hover:bg-zinc-100">
              <a
                href={`/${post.data.slug}`}
                class="flex min-w-0 flex-col gap-1.5 rounded-md transition-colors duration-200"
              >
                <h3 class="text-mds-primary truncate text-lg leading-5">
                  {post.data.title}
                </h3>
                <p class="text-mds-quaternary mt-0.5 line-clamp-2 text-sm tracking-wide">
                  {getPostDescription(post)}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</SiteLayout>
