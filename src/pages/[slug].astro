---
import "~/styles/content.css";
import { getPostDescription, getPosts } from "~/content/lib/posts";
import SiteLayout from "~/layouts/SiteLayout.astro";
import { render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: post,
  }));
}

type Props = CollectionEntry<"posts">;
const post = Astro.props as Props;
const { Content } = await render(post);
const { title, category, pubDate, updatedDate } = post.data;
const description = getPostDescription(post);
---

<SiteLayout
  title={title}
  description={description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  contentType="article"
  preloadMonoFont
>
  <article class="prose prose-zinc max-w-none">
    <header class="flex flex-col items-center justify-center pt-14 pb-24">
      <p class="text-xs font-medium tracking-[0.14em] text-zinc-500">
        {category}
      </p>

      <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-900">
        {title}
      </h1>

      <time
        datetime={pubDate.toISOString()}
        class="mt-2 text-sm font-medium tracking-wide text-zinc-500"
      >
        {
          pubDate.toLocaleDateString("ko-KR", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </time>
    </header>
    <Content />
  </article>

  <div class="code-reference-return-shell">
    <button
      type="button"
      class="code-reference-return"
      data-code-reference-return
      hidden
    >
      <svg
        data-testid="geist-icon"
        height="16"
        stroke-linejoin="round"
        viewBox="0 0 16 16"
        width="16"
        style="color: currentcolor;"
      >
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M6.46966 13.7803L6.99999 14.3107L8.06065 13.25L7.53032 12.7197L3.56065 8.75001H14.25H15V7.25001H14.25H3.56065L7.53032 3.28034L8.06065 2.75001L6.99999 1.68935L6.46966 2.21968L1.39644 7.2929C1.00592 7.68342 1.00592 8.31659 1.39644 8.70711L6.46966 13.7803Z"
          fill="currentColor"
        >
        </path>
      </svg>
      읽던 곳으로 돌아가기
    </button>
  </div>
  <script>
    import "~/scripts/code-reference";
  </script>
</SiteLayout>
