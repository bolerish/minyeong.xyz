---
import "~/styles/content.css";
import ArrowLeftIcon from "~/assets/icons/arrow-left.svg";
import { getPostDescription, getPosts } from "~/content/lib/posts";
import SiteLayout from "~/layouts/SiteLayout.astro";
import { render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"posts">;
const post = Astro.props as Props;
const { Content } = await render(post);
const { title, pubDate, updatedDate } = post.data;
const description = getPostDescription(post);
---

<SiteLayout
  title={title}
  description={description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  contentType="article"
  preloadMonoFont
>
  <header class="mb-16 flex flex-col items-center justify-center">
    <h1 class="text-mds-primary mb-6 text-4xl font-bold tracking-wider">
      {title}
    </h1>

    <time
      datetime={pubDate.toISOString()}
      class="text-mds-quaternary text-sm font-medium tracking-widest"
    >
      {
        pubDate.toLocaleDateString("ko-KR", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
      }
    </time>
  </header>
  <article class="prose prose-zinc max-w-none">
    <Content />

    <div class="code-reference-return-shell">
      <button
        type="button"
        class="code-reference-return"
        data-code-reference-return
        hidden
      >
        <ArrowLeftIcon />
        읽던 곳으로 돌아가기
      </button>
    </div>
  </article>

  <script>
    import "~/scripts/code-reference";
  </script>
</SiteLayout>
