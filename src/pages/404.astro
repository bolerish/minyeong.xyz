---
import Anchor from "~/components/Anchor.astro";
import BaseLayout from "~/layouts/SiteLayout.astro";
---

<BaseLayout
  title="404 | 페이지를 찾을 수 없습니다"
  description="요청하신 페이지가 존재하지 않거나 이동되었습니다. 홈으로 돌아가거나 검색을 이용해 주세요."
  contentType="website"
  chrome
>
  <div class="h-dvh space-y-6 pt-50">
    <p class="mb-4 text-2xl leading-none font-normal text-zinc-400">404</p>

    <div class="space-y-4">
      <h1 class="text-2xl font-normal">페이지를 찾을 수 없습니다.</h1>
      <p class="text-sm leading-relaxed text-zinc-500">
        요청한 페이지가 없거나, 주소가 변경되었을 수 있습니다.
      </p>
    </div>

    <Anchor href="/" class="text-sm text-zinc-900 underline underline-offset-4">
      홈으로 돌아가기
    </Anchor>
  </div>
</BaseLayout>
