---
import BaseLayout from "~/layouts/SiteLayout.astro";
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청하신 페이지가 존재하지 않거나 이동되었습니다. 홈으로 돌아가거나 검색을 이용해 주세요."
  contentType="website"
  chrome
>
  <div class="mt-20 space-y-8">
    <div class="space-y-5">
      <p class="text-xl leading-none font-normal text-zinc-500">404</p>

      <div class="space-y-2.5">
        <h1 class="text-2xl font-normal text-zinc-900">
          페이지를 찾을 수 없습니다.
        </h1>
        <p class="text-sm leading-relaxed text-zinc-500">
          요청한 페이지가 없거나, 주소가 변경되었을 수 있습니다.
        </p>
      </div>
    </div>

    <a
      href="/"
      class="text-sm text-zinc-700 underline decoration-zinc-300 underline-offset-6 transition-colors duration-150 hover:text-zinc-950 hover:decoration-zinc-500"
    >
      홈으로 돌아가기
    </a>
  </div>
</BaseLayout>
